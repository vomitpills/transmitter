<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:UI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="750"
             x:Class="UI.Pages.ChatPage"
             xmlns:vm="using:UI.ViewModels"
             x:DataType="vm:ChatPageViewModel">
    <UserControl.DataContext>
        <vm:ChatPageViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Border Margin="5"
                BorderBrush="Black"
                CornerRadius="10" BorderThickness="1">
            </Border>
        </DockPanel>

        <controls:ChatHistory Grid.Row="1" Items="{Binding ChatMessages}"/>

        <Border Grid.Row="2" Margin="5" BorderBrush="Black" BorderThickness="1" Height="70" CornerRadius="10" Padding="10">
            <TextBox BorderBrush="Transparent"/>
        </Border>
    </Grid>
</UserControl>
